    <connection>operativna</connection>
    <sql>WITH Uzrast AS (
    SELECT 1 AS IdUzrast, 0 AS MinGod, 2 AS MaxGod
    UNION ALL SELECT 2, 3, 9
    UNION ALL SELECT 3, 10, 19
    UNION ALL SELECT 4, 20, 29
    UNION ALL SELECT 5, 30, 39
    UNION ALL SELECT 6, 40, 49
    UNION ALL SELECT 7, 50, 59
    UNION ALL SELECT 8, 60, 400
)
SELECT
	vreme.IdVreme as IdVreme,
    p.IdPol as IdPol,
    uz.IdUzrast as IdUzrast,
    m.IdMes as IdMestoKorisnika,
    SUM(p.PlacenaCena) as Iznos
FROM PRETPLATA p
JOIN audioskladiste.poslednja_izmena piz ON p.VremeUnosa > piz.PoslednjaIzmena
JOIN KORISNIK k ON p.IdKor = k.IdKor
JOIN MESTO m ON k.IdMes = m.IdMes
JOIN audioskladiste.dim_pol as p on p.Pol = k.Pol
JOIN audioskladiste.dim_vreme as vreme on vreme.DatumVreme = TIMESTAMP(p.Datum, p.Vreme)
JOIN Uzrast uz
    ON (YEAR(CURDATE()) - k.Godiste) BETWEEN uz.MinGod AND uz.MaxGod
GROUP BY vreme.IdVreme, p.IdPol, uz.IdUzrast, m.IdMes;
</sql>
