    <connection>operativna</connection>
    <sql>WITH Uzrast AS (
    SELECT 1 AS IdUzrast, 0 AS MinGod, 2 AS MaxGod
    UNION ALL SELECT 2, 3, 9
    UNION ALL SELECT 3, 10, 19
    UNION ALL SELECT 4, 20, 29
    UNION ALL SELECT 5, 30, 39
    UNION ALL SELECT 6, 40, 49
    UNION ALL SELECT 7, 50, 59
    UNION ALL SELECT 8, 60, 400
)
SELECT
	vreme.IdVreme as IdVreme,
    a.IdAud as IdAudio,
    p.IdPol as IdPol,
    uz.IdUzrast as IdUzrast,
    m_slusac.IdMes as IdMestoKorisnika,
    m_vlasnik.IdMes as IdMestoVlasnika,
    SUM(s.TrajanjeUSekundama) / 60.0 as UkupnoMinutaSlusanja
FROM SLUSANJE s
JOIN audioskladiste.poslednja_izmena piz ON s.VremeUnosa > piz.PoslednjaIzmena
JOIN AUDIO a ON s.IdAud = a.IdAud
JOIN KORISNIK k_slusac ON s.IdKor = k_slusac.IdKor
JOIN MESTO m_slusac ON k_slusac.IdMes = m_slusac.IdMes
JOIN KORISNIK k_vlasnik ON a.IdKor = k_vlasnik.IdKor
JOIN MESTO m_vlasnik ON k_vlasnik.IdMes = m_vlasnik.IdMes
JOIN audioskladiste.dim_pol as p on p.Pol = k_slusac.Pol
JOIN audioskladiste.dim_vreme as vreme on vreme.DatumVreme = TIMESTAMP(s.Datum, s.Vreme)
JOIN Uzrast uz
    ON (YEAR(CURDATE()) - k_slusac.Godiste) BETWEEN uz.MinGod AND uz.MaxGod
GROUP BY vreme.IdVreme, a.IdAud, p.IdPol, uz.IdUzrast, m_slusac.IdMes, m_vlasnik.IdMes;
</sql>
