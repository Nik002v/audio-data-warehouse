  <step>
    <name>ocena_ob</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>operativna</connection>
    <sql>WITH Uzrast AS (
    SELECT 1 AS IdUzrast, 0 AS MinGod, 2 AS MaxGod
    UNION ALL SELECT 2, 3, 9
    UNION ALL SELECT 3, 10, 19
    UNION ALL SELECT 4, 20, 29
    UNION ALL SELECT 5, 30, 39
    UNION ALL SELECT 6, 40, 49
    UNION ALL SELECT 7, 50, 59
    UNION ALL SELECT 8, 60, 400
)
SELECT
    vreme.IdVreme as IdVreme,
    kat.IdKat as IdKategorija,
    p.IdPol as IdPol,
    uz.IdUzrast as IdUzrast,
    m_ocenjivac.IdMes as IdMestoKorisnika,
    m_vlasnik.IdMes as IdMestoVlasnika,
    SUM(o.Ocena) * 1.0 / COUNT(*) as ProsecnaOcena,
    COUNT(*) as UkupanBrojOcena
FROM OCENA o
JOIN audioskladiste.poslednja_izmena piz ON o.VremeUnosa > piz.PoslednjaIzmena
JOIN AUDIO a ON o.IdAud = a.IdAud
JOIN AUDIO_KATEGORIJA ak ON a.IdAud = ak.IdAud
JOIN KATEGORIJA kat ON ak.IdKat = kat.IdKat
JOIN KORISNIK k_ocenjivac ON o.IdKor = k_ocenjivac.IdKor
JOIN MESTO m_ocenjivac ON k_ocenjivac.IdMes = m_ocenjivac.IdMes
JOIN KORISNIK k_vlasnik ON a.IdKor = k_vlasnik.IdKor
JOIN MESTO m_vlasnik ON k_vlasnik.IdMes = m_vlasnik.IdMes
JOIN audioskladiste.dim_pol as p on p.Pol = k_ocenjivac.Pol
JOIN audioskladiste.dim_vreme as vreme on vreme.DatumVreme = TIMESTAMP(o.Datum, o.Vreme)
JOIN Uzrast uz
    ON (YEAR(CURDATE()) - k_ocenjivac.Godiste) BETWEEN uz.MinGod AND uz.MaxGod
GROUP BY vreme.IdVreme, kat.IdKat, p.IdPol, uz.IdUzrast, m_ocenjivac.IdMes, m_vlasnik.IdMes;
</sql>
